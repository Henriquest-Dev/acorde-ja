# Copiar para .env.local. Sem estes valores, o aplicativo funciona apenas localmente.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Pagamentos por gateway externo (ver docs/billing.md). Sem isto, os planos
# aparecem mas a compra fica desactivada — nunca é simulada.
EXPO_PUBLIC_CHECKOUT_URL=
EXPO_PUBLIC_BILLING_PORTAL_URL=

# iPhone: resolvedor DNS-over-HTTPS próprio (NextDNS / AdGuard DNS privado)
# para incluir apostas no perfil de proteção. Opcional.
EXPO_PUBLIC_IOS_DOH_URL=

# Legal e suporte (mostrados em Definições → Sobre)
EXPO_PUBLIC_SUPPORT_EMAIL=
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_TERMS_URL=

# Fornecedores de login social activos no Supabase (vazio = só email). Ex.: google,apple
EXPO_PUBLIC_AUTH_PROVIDERS=
