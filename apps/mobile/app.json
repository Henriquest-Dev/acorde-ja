{
  "expo": {
    "name": "Acorde Já",
    "slug": "acorde-ja",
    "scheme": "acordeja",
    "version": "0.1.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#000000",
    "primaryColor": "#000000",
    "description": "Menos tela. Mais vida.",
    "ios": {
      "bundleIdentifier": "pt.acordeja.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSFaceIDUsageDescription": "Utilizamos o Face ID para proteger o acesso às suas definições do Acorde Já."
      },
      "entitlements": {
        "com.apple.developer.family-controls": true
      }
    },
    "android": {
      "package": "pt.acordeja.app",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 2
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "backgroundColor": "#000000"
    },
    "plugins": [
      [
        "expo-router",
        {
          "headers": {
            "Cross-Origin-Embedder-Policy": "credentialless",
            "Cross-Origin-Opener-Policy": "same-origin"
          }
        }
      ],
      "expo-status-bar",
      "expo-sqlite",
      "expo-secure-store",
      "expo-font",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-localization",
      [
        "expo-notifications",
        {
          "color": "#000000"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Utilizamos o Face ID para proteger o acesso às suas definições do Acorde Já."
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
